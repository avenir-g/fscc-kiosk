:root {
  font-family: 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #ffffff;
  background: #121212;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  height: 100%;
}

body {
  margin: 0;
  min-height: 100vh;
  background: #111827;
}

button, a {
  font: inherit;
}

button {
  cursor: pointer;
}

img, video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.app-shell {
  min-height: 100vh;
  background: var(--bg, #1c1c1c);
  color: #fff;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  padding: 1rem 1.5rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(0, 0, 0, 0.18);
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.8rem;
  height: 2.8rem;
  border-radius: 0.75rem;
  background: var(--accent, #0e85b5);
  color: #fff;
  font-weight: 800;
  letter-spacing: 0.06em;
}

.eyebrow {
  margin: 0;
  font-size: 0.74rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  opacity: 0.8;
}

.title-small {
  font-size: 0.9rem;
  font-weight: 700;
}

.topbar-actions {
  display: flex;
  gap: 0.75rem;
}

.ghost-button,
.pager-button {
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.04);
  color: #fff;
  padding: 0.7rem 1rem;
  border-radius: 999px;
}

.overview-page {
  flex: 1;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 1rem;
}

.overview-header h1 {
  margin: 0.35rem 0 0;
  font-size: clamp(2rem, 3vw, 3rem);
  font-weight: 800;
}

.pagination-cluster {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.pager-dots {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.pager-dot {
  width: 0.7rem;
  height: 0.7rem;
  border-radius: 50%;
  border: 0;
  background: rgba(255, 255, 255, 0.28);
}

.pager-dot.active {
  background: var(--accent, #0e85b5);
}

.overview-grid {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(220px, 1fr));
  gap: 1.25rem;
}

.overview-card {
  position: relative;
  border: 0;
  border-radius: 1.25rem;
  overflow: hidden;
  min-height: 18rem;
  text-align: left;
  color: #fff;
  box-shadow: 0 18px 38px rgba(0, 0, 0, 0.16);
}

.overview-media {
  position: absolute;
  inset: 0;
}

.overview-media::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.68));
}

.overview-card-content {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1.25rem;
}

.overview-card h2 {
  margin: 0.4rem 0 0.5rem;
  font-size: clamp(1.2rem, 2vw, 2rem);
  line-height: 1.1;
}

.overview-card p {
  margin: 0;
  opacity: 0.82;
}

.overview-kicker {
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  opacity: 0.85;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 1rem;
}

.tag-row span {
  display: inline-flex;
  align-items: center;
  padding: 0.35rem 0.6rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.12);
  font-size: 0.72rem;
  letter-spacing: 0.04em;
}

.slide-stage {
  flex: 1;
  padding: 1.25rem;
  display: flex;
  align-items: stretch;
}

.slide-panel {
  position: relative;
  flex: 1;
  overflow: hidden;
  border-radius: 1.5rem;
  background: rgba(0, 0, 0, 0.45);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18);
  animation: fadeIn 0.45s ease;
}

.media-layer {
  position: absolute;
  inset: 0;
}

.media-layer::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.63) 0%, rgba(0, 0, 0, 0.35) 35%, rgba(0, 0, 0, 0.58) 100%);
}

.content-overlay {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  max-width: 56rem;
  padding: 4rem clamp(1.5rem, 4vw, 4rem);
}

.slide-title-wrap h2 {
  margin: 0.6rem 0 0;
  color: #fff;
  font-size: clamp(2.5rem, 5vw, 6rem);
  line-height: 0.95;
  letter-spacing: -0.05em;
  text-transform: uppercase;
}

.content-overlay h3 {
  margin: 0.8rem 0 0;
  font-size: clamp(1.1rem, 2vw, 2rem);
  opacity: 0.92;
}

.body-block {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-top: 1.25rem;
  max-width: 38rem;
}

.body-block p {
  margin: 0;
  font-size: 1.08rem;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.9);
}

.cta-button {
  display: inline-flex;
  align-self: flex-start;
  margin-top: 1.25rem;
  background: var(--accent, #0e85b5);
  color: white;
  text-decoration: none;
  padding: 0.9rem 1.25rem;
  border-radius: 999px;
  font-weight: 700;
}

.progress-wrap {
  position: absolute;
  left: 1rem;
  right: 1rem;
  bottom: 1rem;
  z-index: 2;
  height: 0.45rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.2);
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--accent, #0e85b5), #bfeaff);
  border-radius: inherit;
  transition: width 0.12s linear;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 900px) {
  .overview-grid {
    grid-template-columns: 1fr;
  }

  .overview-header {
    flex-direction: column;
    align-items: start;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }
}
